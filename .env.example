BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet is the hard default. Going live requires BOTH of these set explicitly.
USE_TESTNET=true
I_UNDERSTAND_LIVE_TRADING_RISK=false

MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
POSITION_SIZE_FRACTION=0.1

DB_PATH=trading_bot.db

# Shared secret for `serve`'s POST /signals (min 16 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNAL_WEBHOOK_SECRET=

# IRL Engine gate for `serve --irl` (every order: authorize -> place -> bind).
# On the shared VPS network the engine is reachable as http://irl-engine:4000.
IRL_BASE_URL=
IRL_API_TOKEN=
# Printed by `trading-bot irl-register --max-notional <cap>`.
IRL_AGENT_ID=
# Layer-2 signed heartbeats, required when IRL runs with LAYER2_ENABLED=true
# (its default). Needs a MacroPulse API key with the irl_sidecar tier.
IRL_HEARTBEAT_URL=
MACROPULSE_API_KEY=
